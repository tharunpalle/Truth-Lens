# ==============================================================================
# Truth Lens - Environment Configuration Template
# Duplicate this file as '.env' and update values appropriately for your environment.
# DO NOT store production passwords or secret keys in this template.
# ==============================================================================

# Application Settings
APP_NAME=Truth Lens
APP_ENV=development
DEBUG=True
HOST=127.0.0.1
PORT=5000

# Security (Generate a secure random secret key in production)
# Example: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=dev-secret-key-change-in-production-truth-lens-2026

# Logging Configuration (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Future Extension Slots (Placeholders for upcoming phases)
# API_BASE_URL=http://127.0.0.1:5000/api
# DATABASE_URL=sqlite:///truth_lens.db
